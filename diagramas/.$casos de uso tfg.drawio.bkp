        <mxCell id="ytKAlqiokoSu8Pn4SUew-30" value="El administrador debe poder hacer CRUD sobre toda la BBDD, y el bibliotecario sobre ejemplares y socios" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" parent="1" vertex="1">
          <mxGeometry x="700" y="430" width="540" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ytKAlqiokoSu8Pn4SUew-55" value="Tal vez estas funcionalidades &quot;espejo&quot; que tiene el socio no sean útiles,&lt;div&gt;hay que plantearse cómo el usuario devuelve el libro a la biblioteca. También&lt;/div&gt;&lt;div&gt;puede ser que haya recursos digitales que puedan sacar desde sus casas&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" parent="1" vertex="1">
