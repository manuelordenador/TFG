# .env.example
# Copia este archivo a .env y rellena los valores reales.

# Email (SMTP)
EMAIL_HOST_USER=tu_correo@example.com
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion
DB_HOST=db
DB_NAME=liber_bd
DB_USER=admin
DB_PASSWORD=admin
DB_PORT=5432
# variables de migraciones e hidratación de base de datos
RUN_MIGRATIONS=false
RUN_POPULATE=false
RUN_PIP=false
# variables de políticas de préstamos
DIAS_PRESTAMO=20
PRORROGAS_INICIALES=3
DIAS_PRORROGA=5
LIMITE_LIBROS=3
LIMITE_GRABACIONES=2
LIMITE_REVISTAS=1