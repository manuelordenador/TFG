# .env.example
# Copia este archivo a .env/.env.prod y rellena los valores reales.

# variables de base de datos
DB_HOST=db
DB_NAME=liber_bd
DB_USER=admin
DB_PASSWORD=admin
DB_PORT=5432
POSTGRES_DB=liber_bd
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# variables de django
SECRET_KEY=tupasswordaqui
DEBUG=False
# DEBUG=True
ALLOWED_HOSTS=tusitio.duckdns.org,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=https://tusitio.duckdns.org,http://localhost
# STATIC_ROOT=BASE_DIR / staticfiles
STATIC_ROOT=/vol/web/static

# variables duckDNS y certbot
DUCKDNS_DOMAIN=tusitio.duckdns.org
DUCKDNS_TOKEN=tu_token_real
CERTBOT_EMAIL=tu_correo@example.com

# variables pgadmin (solo desarrollo)
PGADMIN_DEFAULT_EMAIL=admin@ejemplo.com
PGADMIN_DEFAULT_PASSWORD=admin

# miscelánea django (actualizar librerías, poblar bdd, migrar estructuras de datos)
RUN_MIGRATIONS=true
RUN_POPULATE=false
RUN_PIP=false

# variables de política de préstamos
DIAS_PRESTAMO=1
LIMITE_LIBROS=3
LIMITE_GRABACIONES=2
LIMITE_REVISTAS=1
DIAS_CASTIGO=10
PRORROGAS_INICIALES=3
DIAS_PRORROGA=1
DIAS_BORRADO_PRESTAMOS=30

# Información de aplicación de gmail para recuperación de contraseñas
EMAIL_HOST_USER=tucorreo@gmail.com
EMAIL_HOST_PASSWORD=aaaa bbbb cccc dddd